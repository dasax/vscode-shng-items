{
  "name": "shng-items",
  "displayName": "SmartHomeNG Items",
  "description": "%description%",
  "version": "1.0.0",
  "publisher": "dasax",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/dasax/vscode-shng-items.git" },
  "bugs": { "url": "https://github.com/dasax/vscode-shng-items/issues" },
  "homepage": "https://github.com/dasax/vscode-shng-items#readme",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Programming Languages", "Visualization", "Other"],
  "keywords": ["SmartHomeNG", "smarthome.py", "smartVISU", "KNX", "ETS", "home automation", "YAML"],
  "galleryBanner": { "color": "#1E5A96", "theme": "dark" },
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:items/*.yaml",
    "workspaceContains:etc/smarthome.yaml",
    "onLanguage:yaml"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "shng", "title": "SmartHomeNG", "icon": "media/icon.svg" }
      ]
    },
    "views": {
      "shng": [
        { "id": "shngItems.categories", "type": "webview", "name": "%view.filter%", "icon": "media/icon.svg" },
        { "id": "shngItems.search", "type": "webview", "name": "%view.search%", "icon": "media/icon.svg" },
        { "id": "shngItems.tree", "name": "%view.items%", "icon": "media/icon.svg" }
      ]
    },
    "commands": [
      { "command": "shngItems.focusSearch", "title": "%command.focusSearch%", "category": "SmartHomeNG", "icon": "$(search)" },
      { "command": "shngItems.refresh", "title": "%command.refresh%", "category": "SmartHomeNG", "icon": "$(refresh)" },
      { "command": "shngItems.filter", "title": "%command.filter%", "category": "SmartHomeNG", "icon": "$(filter)" },
      { "command": "shngItems.clearFilter", "title": "%command.clearFilter%", "category": "SmartHomeNG", "icon": "$(filter-filled)" },
      { "command": "shngItems.clearCategories", "title": "%command.clearCategories%", "category": "SmartHomeNG", "icon": "$(clear-all)" },
      { "command": "shngItems.goto", "title": "%command.goto%", "category": "SmartHomeNG", "icon": "$(search)" },
      { "command": "shngItems.overview", "title": "%command.overview%", "category": "SmartHomeNG", "icon": "$(table)" },
      { "command": "shngItems.copyPath", "title": "%command.copyPath%", "category": "SmartHomeNG", "icon": "$(copy)" },
      { "command": "shngItems.findReferences", "title": "%command.findReferences%", "category": "SmartHomeNG", "icon": "$(references)" },
      { "command": "shngItems.revealCurrent", "title": "%command.revealCurrent%", "category": "SmartHomeNG", "icon": "$(target)" },
      { "command": "shngItems.toggleAttributes", "title": "%command.toggleAttributes%", "category": "SmartHomeNG" },
      { "command": "shngItems.toggleStructItems", "title": "%command.toggleStructItems%", "category": "SmartHomeNG" },
      { "command": "shngItems.toggleSort", "title": "%command.toggleSort%", "category": "SmartHomeNG" },
      { "command": "shngItems.hideAttributes", "title": "%command.hideAttributes%", "category": "SmartHomeNG", "icon": "$(symbol-property)" },
      { "command": "shngItems.showAttributes", "title": "%command.showAttributes%", "category": "SmartHomeNG", "icon": "$(symbol-property)" },
      { "command": "shngItems.hideStructItems", "title": "%command.hideStructItems%", "category": "SmartHomeNG", "icon": "$(symbol-structure)" },
      { "command": "shngItems.showStructItems", "title": "%command.showStructItems%", "category": "SmartHomeNG", "icon": "$(symbol-structure)" },
      { "command": "shngItems.sortFileOrder", "title": "%command.sortFileOrder%", "category": "SmartHomeNG", "icon": "$(sort-precedence)" },
      { "command": "shngItems.sortAlpha", "title": "%command.sortAlpha%", "category": "SmartHomeNG", "icon": "$(sort-precedence)" },
      { "command": "shngItems.open", "title": "%command.open%", "category": "SmartHomeNG" }
    ],
    "menus": {
      "view/title": [
        { "command": "shngItems.filter", "when": "view == shngItems.tree && !shngItems.filtered", "group": "navigation@1" },
        { "command": "shngItems.clearFilter", "when": "view == shngItems.tree && shngItems.filtered", "group": "navigation@1" },
        { "command": "shngItems.goto", "when": "view == shngItems.tree", "group": "navigation@2" },
        { "command": "shngItems.overview", "when": "view == shngItems.tree", "group": "navigation@3" },
        { "command": "shngItems.refresh", "when": "view == shngItems.tree", "group": "navigation@4" },
        { "command": "shngItems.clearCategories", "when": "view == shngItems.categories && shngItems.categoriesActive", "group": "navigation@1" },
        { "command": "shngItems.hideAttributes", "when": "view == shngItems.tree && config.shngItems.showAttributes", "group": "navigation@5" },
        { "command": "shngItems.showAttributes", "when": "view == shngItems.tree && !config.shngItems.showAttributes", "group": "navigation@5" },
        { "command": "shngItems.hideStructItems", "when": "view == shngItems.tree && config.shngItems.showStructItems", "group": "navigation@6" },
        { "command": "shngItems.showStructItems", "when": "view == shngItems.tree && !config.shngItems.showStructItems", "group": "navigation@6" },
        { "command": "shngItems.sortFileOrder", "when": "view == shngItems.tree && config.shngItems.sortAlphabetically", "group": "navigation@7" },
        { "command": "shngItems.sortAlpha", "when": "view == shngItems.tree && !config.shngItems.sortAlphabetically", "group": "navigation@7" }
      ],
      "view/item/context": [
        { "command": "shngItems.copyPath", "when": "view == shngItems.tree && viewItem =~ /^item/", "group": "inline" },
        { "command": "shngItems.copyPath", "when": "view == shngItems.tree && viewItem =~ /^item/", "group": "1_item@1" },
        { "command": "shngItems.findReferences", "when": "view == shngItems.tree && viewItem =~ /^item/", "group": "1_item@2" }
      ],
      "editor/context": [
        { "command": "shngItems.revealCurrent", "when": "resourceExtname == .yaml", "group": "navigation@90" }
      ],
      "commandPalette": [
        { "command": "shngItems.open", "when": "false" },
        { "command": "shngItems.copyPath", "when": "false" },
        { "command": "shngItems.findReferences", "when": "false" },
        { "command": "shngItems.clearFilter", "when": "shngItems.filtered" },
        { "command": "shngItems.hideAttributes", "when": "false" },
        { "command": "shngItems.showAttributes", "when": "false" },
        { "command": "shngItems.hideStructItems", "when": "false" },
        { "command": "shngItems.showStructItems", "when": "false" },
        { "command": "shngItems.sortFileOrder", "when": "false" },
        { "command": "shngItems.sortAlpha", "when": "false" }
      ]
    },
    "keybindings": [
      { "command": "shngItems.focusSearch", "key": "ctrl+shift+alt+i" }
    ],
    "configuration": {
      "title": "SmartHomeNG Items",
      "properties": {
        "shngItems.language": {
          "type": "string",
          "default": "en",
          "enum": ["en", "de", "es", "fr", "it", "nl", "auto"],
          "enumItemLabels": ["English", "Deutsch", "Español", "Français", "Italiano", "Nederlands", "Auto"],
          "markdownEnumDescriptions": ["", "", "", "", "", "", "%config.language.auto%"],
          "markdownDescription": "%config.language%",
          "order": 0
        },
        "shngItems.basePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.basePath%"
        },
        "shngItems.knxProject": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.knxProject%"
        },
        "shngItems.showAttributes": {
          "type": "boolean",
          "default": true,
          "description": "%config.showAttributes%"
        },
        "shngItems.showStructItems": {
          "type": "boolean",
          "default": true,
          "description": "%config.showStructItems%"
        },
        "shngItems.sortAlphabetically": {
          "type": "boolean",
          "default": false,
          "description": "%config.sortAlphabetically%"
        },
        "shngItems.categories": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } },
          "markdownDescription": "%config.categories%",
          "default": {
            "eval / logic": ["eval", "eval_trigger", "on_change", "on_update"],
            "Timers": ["crontab", "cycle", "autotimer"],
            "smartVISU": ["visu_acl", "sv_*"],
            "Cache": ["cache", "initial_value"]
          }
        },
        "shngItems.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "%config.diagnostics%"
        }
      }
    }
  }
}
